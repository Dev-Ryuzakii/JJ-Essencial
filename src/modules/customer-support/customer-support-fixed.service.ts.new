import { Injectable, NotFoundException, ForbiddenException } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { SupabaseClient } from '@supabase/supabase-js';
import { SupabaseConfig } from '../../config/supabase.config';

type ChatStatus = 'OPEN' | 'IN_PROGRESS' | 'CLOSED';
type ChatPriority = 'LOW' | 'MEDIUM' | 'HIGH';

export interface CreateSupportChatDto {
  subject: string;
  priority?: ChatPriority;
  initialMessage: string;
}

export interface CreateChatMessageDto {
  chatId: string;
  message: string;
  isFromSupport?: boolean;
}

export interface UpdateChatStatusDto {
  status: ChatStatus;
}

@Injectable()
export class CustomerSupportService {
  private supabase: SupabaseClient;

  constructor(private readonly configService: ConfigService) {
    this.supabase = SupabaseConfig.getInstance(this.configService);
  }

  async createSupportChat(userId: string, dto: CreateSupportChatDto): Promise<any> {
    try {
      // Create the chat first
      const { data: chat, error: chatError } = await this.supabase
        .from('support_chat')
        .insert({
          user_id: userId,
          subject: dto.subject,
          priority: dto.priority || 'MEDIUM',
          status: 'OPEN',
        })
        .select()
        .single();

      if (chatError) throw new Error(chatError.message);

      // Then create the initial message
      const { data: message, error: messageError } = await this.supabase
        .from('chat_message')
        .insert({
          chat_id: chat.id,
          sender_id: userId,
          message: dto.initialMessage,
          is_admin: false,
        })
        .select()
        .single();

      if (messageError) throw new Error(messageError.message);

      // Get the complete chat with relationships
      const { data: fullChat, error: fullChatError } = await this.supabase
        .from('support_chat')
        .select(`
          *,
          user:user_id (
            id,
            email,
            full_name
          ),
          messages:chat_message (
            *,
            sender:sender_id (
              id,
              email,
              full_name
            )
          )
        `)
        .eq('id', chat.id)
        .single();

      if (fullChatError) throw new Error(fullChatError.message);
      
      return fullChat;
    } catch (error) {
      throw new Error(`Failed to create support chat: ${error.message}`);
    }
  }

  async addMessageToChat(userId: string, dto: CreateChatMessageDto): Promise<any> {
    try {
      // Verify chat exists and user has access
      const { data: chat, error: chatError } = await this.supabase
        .from('support_chat')
        .select('*, user:user_id (*)')
        .eq('id', dto.chatId)
        .single();

      if (chatError) throw new Error(chatError.message);
      if (!chat) throw new NotFoundException('Chat not found');

      // Users can only message their own chats (unless they're support)
      if (chat.user_id !== userId && !dto.isFromSupport) {
        throw new ForbiddenException('Access denied to this chat');
      }

      const { data: message, error: messageError } = await this.supabase
        .from('chat_message')
        .insert({
          chat_id: dto.chatId,
          sender_id: userId,
          message: dto.message,
          is_admin: dto.isFromSupport || false,
        })
        .select(`
          *,
          sender:sender_id (
            id,
            email,
            full_name
          )
        `)
        .single();

      if (messageError) throw new Error(messageError.message);
      return message;
    } catch (error) {
      if (error instanceof NotFoundException || error instanceof ForbiddenException) {
        throw error;
      }
      throw new Error(`Failed to add message to chat: ${error.message}`);
    }
  }

  async getUserChats(userId: string): Promise<any[]> {
    try {
      const { data: chats, error } = await this.supabase
        .from('support_chat')
        .select(`
          *,
          messages:chat_message (
            *,
            sender:sender_id (
              id,
              email,
              full_name
            )
          ),
          message_count:chat_message (count)
        `)
        .eq('user_id', userId)
        .order('created_at', { ascending: false });

      if (error) throw new Error(error.message);

      return chats.map(chat => ({
        ...chat,
        messages: [chat.messages[0]], // Only keep the latest message
        _count: {
          messages: chat.message_count
        }
      }));
    } catch (error) {
      throw new Error(`Failed to get user chats: ${error.message}`);
    }
  }

  async getChatDetails(chatId: string, userId?: string): Promise<any> {
    try {
      const { data: chat, error } = await this.supabase
        .from('support_chat')
        .select(`
          *,
          user:user_id (
            id,
            email,
            full_name
          ),
          messages:chat_message (
            *,
            sender:sender_id (
              id,
              email,
              full_name
            )
          )
        `)
        .eq('id', chatId)
        .order('created_at', { foreignTable: 'messages', ascending: true })
        .single();

      if (error) throw new Error(error.message);
      if (!chat) throw new NotFoundException('Chat not found');

      // If userId provided, check access (users can only see their own chats)
      if (userId && chat.user_id !== userId) {
        throw new ForbiddenException('Access denied to this chat');
      }

      return chat;
    } catch (error) {
      if (error instanceof NotFoundException || error instanceof ForbiddenException) {
        throw error;
      }
      throw new Error(`Failed to get chat details: ${error.message}`);
    }
  }

  async updateChatStatus(chatId: string, dto: UpdateChatStatusDto): Promise<any> {
    try {
      const { data: chat, error } = await this.supabase
        .from('support_chat')
        .update({ status: dto.status })
        .eq('id', chatId)
        .select(`
          *,
          user:user_id (
            id,
            email,
            full_name
          )
        `)
        .single();

      if (error) throw new Error(error.message);
      if (!chat) throw new NotFoundException('Chat not found');

      return chat;
    } catch (error) {
      if (error instanceof NotFoundException) {
        throw error;
      }
      throw new Error(`Failed to update chat status: ${error.message}`);
    }
  }

  async getAllChats(
    page: number = 1,
    limit: number = 20,
    status?: ChatStatus,
    priority?: ChatPriority,
  ): Promise<{
    chats: any[];
    pagination: {
      page: number;
      limit: number;
      total: number;
      totalPages: number;
    };
  }> {
    try {
      const start = (page - 1) * limit;
      const end = start + limit - 1;

      let query = this.supabase
        .from('support_chat')
        .select(`
          *,
          user:user_id (
            id,
            email,
            full_name
          ),
          messages:chat_message (
            *,
            sender:sender_id (
              id,
              email,
              full_name
            )
          ),
          message_count:chat_message (count)
        `, { count: 'exact' })
        .order('updated_at', { ascending: false })
        .range(start, end);

      if (status) {
        query = query.eq('status', status);
      }
      if (priority) {
        query = query.eq('priority', priority);
      }

      const { data: chats, count, error } = await query;

      if (error) throw new Error(error.message);

      const transformedChats = chats.map(chat => ({
        ...chat,
        messages: [chat.messages[0]], // Only keep the latest message
        _count: {
          messages: chat.message_count
        }
      }));

      return {
        chats: transformedChats,
        pagination: {
          page,
          limit,
          total: count || 0,
          totalPages: Math.ceil((count || 0) / limit),
        },
      };
    } catch (error) {
      throw new Error(`Failed to get all chats: ${error.message}`);
    }
  }

  async getChatStats(): Promise<{
    totalChats: number;
    openChats: number;
    inProgressChats: number;
    closedChats: number;
    highPriorityChats: number;
    chatsByPriority: Record<string, number>;
  }> {
    try {
      const { data: stats, error } = await this.supabase
        .from('support_chat')
        .select('status, priority');

      if (error) throw new Error(error.message);

      const totalChats = stats.length;
      const openChats = stats.filter(c => c.status === 'OPEN').length;
      const inProgressChats = stats.filter(c => c.status === 'IN_PROGRESS').length;
      const closedChats = stats.filter(c => c.status === 'CLOSED').length;
      const highPriorityChats = stats.filter(c => c.priority === 'HIGH').length;

      const chatsByPriority = stats.reduce((acc, curr) => {
        acc[curr.priority] = (acc[curr.priority] || 0) + 1;
        return acc;
      }, {} as Record<string, number>);

      return {
        totalChats,
        openChats,
        inProgressChats,
        closedChats,
        highPriorityChats,
        chatsByPriority,
      };
    } catch (error) {
      throw new Error(`Failed to get chat stats: ${error.message}`);
    }
  }

  async assignChatToSupport(chatId: string, supportUserId: string): Promise<any> {
    try {
      const { data: chat, error } = await this.supabase
        .from('support_chat')
        .update({
          assigned_to: supportUserId,
          status: 'IN_PROGRESS',
        })
        .eq('id', chatId)
        .select(`
          *,
          user:user_id (
            id,
            email,
            full_name
          )
        `)
        .single();

      if (error) throw new Error(error.message);
      if (!chat) throw new NotFoundException('Chat not found');

      return chat;
    } catch (error) {
      if (error instanceof NotFoundException) {
        throw error;
      }
      throw new Error(`Failed to assign chat to support: ${error.message}`);
    }
  }
}
