# =============================================================================
# JJ-ESSENCIAL E-COMMERCE BACKEND - ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (SUPABASE)
# -----------------------------------------------------------------------------
DATABASE_URL=your_supabase_database_url
DIRECT_URL=your_supabase_direct_url

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Admin Credentials
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=your_secure_admin_password

# Security Settings
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# SMTP Settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_or_password

# Email From Settings
FROM_EMAIL=noreply@yourstore.com
FROM_NAME=Your E-commerce Store

# Admin notification email (defaults to FROM_EMAIL if not set)
ADMIN_EMAIL=admin@yourstore.com

# -----------------------------------------------------------------------------
# PAYMENT GATEWAYS
# -----------------------------------------------------------------------------
# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Flutterwave Configuration
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST-your_encryption_key
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_secret_hash

# -----------------------------------------------------------------------------
# FILE UPLOAD SETTINGS
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# =============================================================================
# EMAIL SETUP INSTRUCTIONS
# =============================================================================
#
# For Gmail SMTP:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an App Password:
#    - Go to Gmail Settings > Security
#    - Select "App passwords" under "2-Step Verification"
#    - Generate password for "Mail"
#    - Use this password in SMTP_PASS
#
# For Other Email Providers:
# - Outlook: smtp-mail.outlook.com:587
# - Yahoo: smtp.mail.yahoo.com:587
# - Custom SMTP: Use your provider's settings
#
# =============================================================================

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# Production Environment Variables:
# - Change JWT_SECRET to a strong, random string
# - Use production Paystack/Flutterwave keys (sk_live_, pk_live_)
# - Set strong ADMIN_PASSWORD
# - Configure production SMTP settings
# - Set correct FRONTEND_URL for your domain
# - Update ALLOWED_ORIGINS for your frontend domains
#
# =============================================================================