// Prisma schema for E-commerce Backend with Supabase PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Used for migrations
}

// User profiles linked to Supabase Auth
model Profile {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String   @map("full_name")
  phone     String?
  avatar    String?  // Profile picture URL
  dateOfBirth DateTime? @map("date_of_birth")
  role      String   @default("USER") // Using String instead of enum for compatibility
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  orders           Orders[]
  trades           Trade[]
  addresses        UserAddress[]
  wishlistItems    WishlistItem[]
  reviews          ProductReview[]
  supportChats     SupportChat[]
  chatMessages     ChatMessage[]
  uploadedReceipts PaymentReceipt[] @relation("ReceiptUploader")
  verifiedReceipts PaymentReceipt[] @relation("ReceiptVerifier")

  @@map("profiles")
}

// User addresses for delivery and billing
model UserAddress {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        AddressType @default(SHIPPING) // SHIPPING, BILLING, BOTH
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  company     String?
  address1    String   @map("address_1")
  address2    String?  @map("address_2")
  city        String
  state       String
  postalCode  String   @map("postal_code")
  country     String
  phone       String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Orders[]

  @@map("user_addresses")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  lowStockThreshold Int @default(10) @map("low_stock_threshold")
  images      String[] // Array of image URLs
  category    String?
  categoryId  String?  @map("category_id")
  sku         String?  @unique // Stock Keeping Unit
  brand       String?
  weight      Decimal? @db.Decimal(8, 2) // Product weight in kg
  dimensions  String?  // Product dimensions
  tags        String[] // Product tags for search
  featured    Boolean  @default(false) // Featured products
  avgRating   Decimal? @default(0) @db.Decimal(3, 2) @map("avg_rating")
  reviewCount Int      @default(0) @map("review_count")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  productCategory Category?      @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  trades          Trade[]
  wishlistItems   WishlistItem[]
  reviews         ProductReview[]
  stockMovements  StockMovement[]

  @@map("products")
}

model Orders {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  addressId     String?     @map("address_id")
  totalAmount   Decimal     @db.Decimal(10, 2) @map("total_amount")
  status        OrderStatus @default(PENDING)
  paymentRef    String?     @map("payment_ref")
  receiptUrl    String?     @map("receipt_url")
  
  // Delivery information
  deliveryPhone   String?   @map("delivery_phone")
  deliveryAddress String?   @map("delivery_address")
  deliveryCity    String?   @map("delivery_city")
  deliveryState   String?   @map("delivery_state")
  deliveryPostal  String?   @map("delivery_postal")
  deliveryCountry String?   @map("delivery_country")
  
  // Order notes and special instructions
  orderNotes      String?   @map("order_notes")
  
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  user         Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address      UserAddress? @relation(fields: [addressId], references: [id])
  orderItems   OrderItem[]
  payments     PaymentTransaction[]
  reviews      ProductReview[]
  tracking     OrderTracking[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  price     Decimal @db.Decimal(10, 2) // Price at time of purchase

  // Relations
  order   Orders  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Trade {
  id        String      @id @default(uuid())
  sellerId  String      @map("seller_id")
  productId String      @map("product_id")
  price     Decimal     @db.Decimal(10, 2)
  status    TradeStatus @default(PENDING)
  description String?
  images    String[] // Array of image URLs
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  // Relations
  seller  Profile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("trades")
}

model PaymentTransaction {
  id            String        @id @default(uuid())
  orderId       String?       @map("order_id")
  reference     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  gateway       PaymentGateway
  status        PaymentStatus @default(PENDING)
  gatewayData   Json?         @map("gateway_data") // Store gateway response
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  order         Orders?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receipts      PaymentReceipt[]

  @@map("payment_transactions")
}

model PaymentReceipt {
  id              String             @id @default(uuid())
  transactionId   String             @map("transaction_id")
  receiptUrl      String             @map("receipt_url")
  originalName    String             @map("original_name")
  fileSize        Int                @map("file_size")
  mimeType        String             @map("mime_type")
  uploadedBy      String             @map("uploaded_by") // User ID who uploaded
  verifiedBy      String?            @map("verified_by") // Admin ID who verified
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verificationNotes String?          @map("verification_notes")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  // Relations
  transaction     PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  uploader        Profile            @relation("ReceiptUploader", fields: [uploadedBy], references: [id])
  verifier        Profile?           @relation("ReceiptVerifier", fields: [verifiedBy], references: [id])

  @@map("payment_receipts")
}

// Add bank account information model
model BankAccount {
  id          String   @id @default(uuid())
  bankName    String   @map("bank_name")
  accountName String   @map("account_name")
  accountNumber String @map("account_number")
  sortCode    String?  @map("sort_code")
  swiftCode   String?  @map("swift_code")
  currency    String   @default("NGN")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("bank_accounts")
}

// Category management
model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  slug        String   @unique
  image       String?  // Category image URL
  parentId    String?  @map("parent_id") // For nested categories
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  products   Product[]

  @@map("categories")
}

// Wishlist/Favorites
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// Product Reviews & Ratings
model ProductReview {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  orderId   String?  @map("order_id") // Only customers who bought can review
  rating    Int      // 1-5 stars
  title     String?
  comment   String?
  images    String[] // Review images
  isVerified Boolean @default(false) @map("is_verified") // Verified purchase
  isVisible  Boolean @default(true) @map("is_visible") // Admin can hide
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Orders? @relation(fields: [orderId], references: [id])

  @@unique([userId, productId, orderId])
  @@map("product_reviews")
}

// Stock Movement Tracking
model StockMovement {
  id          String          @id @default(uuid())
  productId   String          @map("product_id")
  type        StockMovementType
  quantity    Int             // Positive for in, negative for out
  previousStock Int           @map("previous_stock")
  newStock    Int             @map("new_stock")
  reason      String?         // Reason for movement
  reference   String?         // Order ID, supplier ref, etc.
  performedBy String?         @map("performed_by") // Admin user ID
  createdAt   DateTime        @default(now()) @map("created_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

// Order Status Tracking
model OrderTracking {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  location  String?     // Current location
  notes     String?     // Status update notes
  timestamp DateTime    @default(now())
  
  // Relations
  order Orders @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_tracking")
}

// Customer Support Chat
model SupportChat {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  assignedTo String?       @map("assigned_to") // Admin user ID
  subject    String
  status     ChatStatus    @default(OPEN)
  priority   ChatPriority  @default(MEDIUM)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  // Relations
  user     Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("support_chats")
}

model ChatMessage {
  id        String   @id @default(uuid())
  chatId    String   @map("chat_id")
  senderId  String   @map("sender_id")
  message   String
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  chat   SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender Profile     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// Enums
// Note: UserRole is now a String type in the Profile model

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum TradeStatus {
  PENDING
  AVAILABLE
  SOLD
  CANCELLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  AWAITING_VERIFICATION  // For manual bank transfers
}

enum StockMovementType {
  IN          // Stock added
  OUT         // Stock removed
  SALE        // Sold to customer
  RETURN      // Customer return
  ADJUSTMENT  // Manual adjustment
  DAMAGED     // Damaged goods
  EXPIRED     // Expired products
}

enum ChatStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ChatPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
